#!/usr/bin/env bash

set -euo pipefail

SCRIPTPATH=$( dirname "$(realpath "$0")" )

errecho() {
    >&2 echo "${@//$'\n'/}"
}

source "${SCRIPTPATH}/display-help.sh"

define_xargs() {
    export XARGS="xargs"

    if [[ "$(uname)" = "Darwin" ]]; then
        if type -p gxargs &>/dev/null; then
            XARGS=gxargs
        else
            XARGS="xargs -S10240"
        fi
    fi
}

main() {
    define_xargs

    case "${1-help}" in
    -h|--help|help)
        display_help
        exit
        ;;
    exec|download|upload)
        subcmd=$1
        shift
        exec "${SCRIPTPATH}/mexec-${subcmd}" "$@"
        ;;
    *)
        # use "exec" as default subcommand
        exec "${SCRIPTPATH}/mexec-exec" "$@"
        ;;
    esac
}

main "$@"
